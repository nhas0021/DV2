
{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Interactive nesting-habits radial area chart with centred layout and structured tooltips.",
  "width": 1047,
  "height": 656,
  "background": "#ffffff",

  "padding": {
    "left": 5,
    "right": 5,
    "top": 8,
    "bottom": 10
  },

  "autosize": {
    "type": "pad",
    "contains": "padding"
  },

  "signals": [
    {
      "name": "centerX",
      "update": "width / 2"
    },
    {
      "name": "centerY",
      "update": "height / 2"
    },
    {
      "name": "selectedGroup",
      "value": "Parrots",
      "bind": {
        "input": "select",
        "name": "Bird group: ",
        "options": [
          "Parrots",
          "Honeyeaters",
          "Petrels & shearwaters",
          "Ducks & geese",
          "Gulls & terns",
          "Hawks & eagles"
        ]
      }
    }
  ],

  "data": [
    {
      "name": "nesting",
      "url": "../data/nesting_habits_dropdown.csv",
      "format": {
        "type": "csv",
        "parse": {
          "position": "number",
          "species_count": "number",
          "known_species": "number",
          "group_species": "number",
          "percentage": "number",
          "start_angle": "number",
          "end_angle": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.group === selectedGroup"
        }
      ]
    },

    {
      "name": "groupInfo",
      "source": "nesting",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "group",
            "known_species",
            "group_species"
          ]
        }
      ]
    },

    {
      "name": "labels",
      "values": [
        {
          "category": "Ground",
          "label": "On the ground",
          "dx": 123.5,
          "dy": -213.91,
          "align": "center"
        },
        {
          "category": "Supported",
          "label": "Supported",
          "dx": 247,
          "dy": 0,
          "align": "left"
        },
        {
          "category": "Hanging",
          "label": "Hanging",
          "dx": 123.5,
          "dy": 213.91,
          "align": "center"
        },
        {
          "category": "Burrow",
          "label": "In burrows",
          "dx": -123.5,
          "dy": 213.91,
          "align": "center"
        },
        {
          "category": "Hollow",
          "label": "In hollows",
          "dx": -247,
          "dy": 0,
          "align": "right"
        },
        {
          "category": "Floating",
          "label": "Floating",
          "dx": -123.5,
          "dy": -213.91,
          "align": "center"
        }
      ]
    },

    {
      "name": "spokes",
      "values": [
        {
          "dx": 0,
          "dy": -184
        },
        {
          "dx": 159.349,
          "dy": -92
        },
        {
          "dx": 159.349,
          "dy": 92
        },
        {
          "dx": 0,
          "dy": 184
        },
        {
          "dx": -159.349,
          "dy": 92
        },
        {
          "dx": -159.349,
          "dy": -92
        }
      ]
    },

    {
      "name": "rings",
      "values": [
        {
          "radius": 92,
          "label": "25%"
        },
        {
          "radius": 130.108,
          "label": "50%"
        },
        {
          "radius": 159.349,
          "label": "75%"
        },
        {
          "radius": 184,
          "label": "100%"
        }
      ]
    }
  ],

  "marks": [
    {
      "type": "arc",
      "from": {
        "data": "nesting"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "centerX"
          },
          "y": {
            "signal": "centerY"
          },
          "startAngle": {
            "field": "start_angle"
          },
          "endAngle": {
            "field": "end_angle"
          },
          "innerRadius": {
            "value": 0
          },
          "outerRadius": {
            "value": 184
          },
          "fill": {
            "value": "#f2f5f0"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Bird group': datum.group, 'Nesting location': datum.category_label, 'Species recorded': datum.species_count + ' of ' + datum.known_species, 'Percentage': format(datum.percentage, '.1f') + '%'}"
          }
        }
      }
    },

    {
      "type": "arc",
      "from": {
        "data": "nesting"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "centerX"
          },
          "y": {
            "signal": "centerY"
          },
          "startAngle": {
            "field": "start_angle"
          },
          "endAngle": {
            "field": "end_angle"
          },
          "innerRadius": {
            "value": 0
          },
          "outerRadius": {
            "signal": "184 * sqrt(max(0, datum.percentage) / 100)"
          },
          "fill": {
            "field": "group_color"
          },
          "fillOpacity": {
            "value": 0.92
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Bird group': datum.group, 'Nesting location': datum.category_label, 'Species recorded': datum.species_count + ' of ' + datum.known_species, 'Percentage': format(datum.percentage, '.1f') + '%'}"
          }
        },

        "hover": {
          "fillOpacity": {
            "value": 1
          },
          "stroke": {
            "value": "#324b3d"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },

    {
      "type": "arc",
      "interactive": false,
      "from": {
        "data": "rings"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "centerX"
          },
          "y": {
            "signal": "centerY"
          },
          "startAngle": {
            "value": 0
          },
          "endAngle": {
            "signal": "2 * PI"
          },
          "innerRadius": {
            "signal": "datum.radius - 0.7"
          },
          "outerRadius": {
            "field": "radius"
          },
          "fill": {
            "value": "#d1d9d0"
          },
          "fillOpacity": {
            "value": 0.8
          }
        }
      }
    },

    {
      "type": "rule",
      "interactive": false,
      "from": {
        "data": "spokes"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "centerX"
          },
          "y": {
            "signal": "centerY"
          },
          "x2": {
            "signal": "centerX + datum.dx"
          },
          "y2": {
            "signal": "centerY + datum.dy"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 2.4
          }
        }
      }
    },

    {
      "type": "symbol",
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "signal": "centerX"
          },
          "y": {
            "signal": "centerY"
          },
          "shape": {
            "value": "circle"
          },
          "size": {
            "value": 550
          },
          "fill": {
            "value": "#f8faf7"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },

    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "centerX"
          },
          "y": {
            "value": 41
          },
          "text": {
            "signal": "selectedGroup"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 25
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#273128"
          }
        }
      }
    },

    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "groupInfo"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "centerX"
          },
          "y": {
            "value": 73
          },
          "text": {
            "signal": "datum.known_species + ' species with recorded nesting locations'"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "value": "#5b685d"
          }
        }
      }
    },

    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "labels"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "centerX + datum.dx"
          },
          "y": {
            "signal": "centerY + datum.dy"
          },
          "text": {
            "field": "label"
          },
          "align": {
            "field": "align"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 17
          },
          "fill": {
            "value": "#4d5e50"
          }
        }
      }
    },

    {
      "type": "text",
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "signal": "centerX"
          },
          "y": {
            "value": 636
          },
          "text": {
            "value": "Hover for exact percentages. A species may use more than one location."
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#7a8579"
          }
        }
      }
    }
  ],

  "config": {
    "text": {
      "font": "DM Sans"
    }
  },

  "usermeta": {
    "radius_scale": "sqrt(percent / 100) * 184; wedge area is proportional to percentage."
  }
}
