
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 650,
  "height": 480,

  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 0
  },

  "autosize": {
    "type": "pad",
    "contains": "padding"
  },

  "projection": {
    "type": "conicEqualArea",
    "rotate": [-134, 0, 0],
    "parallels": [-18, -36]
  },

  "layer": [
    {
      "data": {
        "url": "australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "australian_states"
        }
      },

      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "../data/australia_bird_choropleth_summary.csv"
            },
            "key": "State",
            "fields": [
              "Total_Species",
              "EPBC_Threatened_Total",
              "EPBC_Threatened_Percent"
            ]
          }
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.3
      },

      "encoding": {
        "color": {
          "field": "EPBC_Threatened_Percent",
          "type": "quantitative",
          "title": "Threatened bird species (%)",
          "scale": {
            "range": [
              "#e5eadc",
              "#cbd5bd",
              "#aab996",
              "#879b73",
              "#687d59",
              "#43563a"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Threatened bird species (%)",
            "titleFont": "DM Sans",
            "labelFont": "DM Sans",
            "titleFontSize": 14,
            "titleFontWeight": 600,
            "labelFontSize": 12,
            "titleColor": "#26342b",
            "labelColor": "#4c594e",
            "titleLimit": 350,
            "gradientLength": 240,
            "gradientThickness": 14,
            "offset": 5,
            "titlePadding": 6,
            "labelPadding": 4
          }
        },

        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Total_Species",
            "type": "quantitative",
            "title": "Bird species"
          },
          {
            "field": "EPBC_Threatened_Total",
            "type": "quantitative",
            "title": "Threatened species"
          },
          {
            "field": "EPBC_Threatened_Percent",
            "type": "quantitative",
            "title": "Threatened share (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "font": "DM Sans"
  }
}
