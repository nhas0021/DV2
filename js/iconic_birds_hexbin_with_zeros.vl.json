        },
        {
          "filter": "datum.occurrenceStatus === 'PRESENT'"
        },
        {
          "filter": "isValid(datum.decimalLatitude) && isValid(datum.decimalLongitude) && isFinite(datum.decimalLatitude) && isFinite(datum.decimalLongitude)"
        },
        {
          "filter": "datum.stateProvince === 'Victoria' && datum.decimalLatitude >= -39.3 && datum.decimalLatitude <= -33.8 && datum.decimalLongitude >= 140.8 && datum.decimalLongitude <= 150.2"
        },
        {
          "calculate": "(datum.decimalLongitude - 140) * 88.8",
          "as": "Xkm"
        },
        {
          "calculate": "(datum.decimalLatitude + 40) * 111.2",
          "as": "Ykm"
        },
        {
          "calculate": "(sqrt(3) / 3 * datum.Xkm - datum.Ykm / 3) / 16",
          "as": "qF"
        },
