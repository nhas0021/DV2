          "as": "eq"
        },
        {
          "calculate": "abs(datum.r0 - datum.rF)",
          "as": "er"
        },
        {
          "calculate": "abs(datum.s0 + datum.qF + datum.rF)",
          "as": "es"
        },
        {
          "calculate": "datum.eq > datum.er && datum.eq > datum.es ? -datum.r0 - datum.s0 : datum.q0",
          "as": "HexQ"
        },
        {
          "calculate": "datum.er > datum.es && datum.er >= datum.eq ? -datum.q0 - datum.s0 : datum.r0",
          "as": "HexR"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Observations"
            }
          ],
          "groupby": [
            "HexQ",
            "HexR"
          ]
        },
        {
          "calculate": "140 + sqrt(3) * 16 * (datum.HexQ + datum.HexR/2) / 88.8",
          "as": "HexLon"
        },
