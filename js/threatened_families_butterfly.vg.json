
{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Mirrored butterfly chart. Species are deduplicated nationally across eight state and territory CSVs. Threatened = EPBC Vulnerable, Endangered or Critically Endangered. Other means not flagged as threatened in these CSVs, not a guarantee of safety.",
  "width": 1035,
  "height": 646,
  "padding": {
    "top": 0,
    "bottom": 0,
    "left": 10,
    "right": 10
  },
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "background": "#ffffff",
  "signals": [
    {
      "name": "chartCenter",
      "update": "width / 2"
    },
    {
      "name": "leftZero",
      "update": "chartCenter - 143.5"
    },
    {
      "name": "rightZero",
      "update": "chartCenter + 143.5"
    },
    {
      "name": "barScale",
      "value": 6.4
    }
  ],
  "data": [
    {
      "name": "families",
      "url": "../data/threatened_families_butterfly.csv",
      "format": {
        "type": "csv",
        "parse": {
          "total_species": "number",
          "threatened_species": "number",
          "not_threatened_species": "number",
          "threatened_pct": "number",
          "rank": "number"
        }
      }
    },
    {
      "name": "ticks",
      "values": [
        { "value": 0 },
        { "value": 10 },
        { "value": 20 },
        { "value": 30 },
        { "value": 40 }
      ]
    },
    {
      "name": "rows",
      "values": [
        { "rank": 1 },
        { "rank": 2 },
        { "rank": 3 },
        { "rank": 4 },
        { "rank": 5 },
        { "rank": 6 },
        { "rank": 7 },
        { "rank": 8 },
        { "rank": 9 },
        { "rank": 10 },
        { "rank": 11 }
      ]
    }
  ],
  "marks": [
    {
      "type": "rule",
      "from": {
        "data": "ticks"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "leftZero - datum.value * barScale"
          },
          "y": {
            "value": 64
          },
          "y2": {
            "value": 579
          },
          "stroke": {
            "value": "#e8ede7"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "ticks"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "rightZero + datum.value * barScale"
          },
          "y": {
            "value": 64
          },
          "y2": {
            "value": 579
          },
          "stroke": {
            "value": "#e8ede7"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "rows"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 60
          },
          "x2": {
            "signal": "width - 60"
          },
          "y": {
            "signal": "123 + (datum.rank - 1) * 40"
          },
          "stroke": {
            "value": "#f3f5f1"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "ticks"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "leftZero - datum.value * barScale"
          },
          "y": {
            "value": 600
          },
          "text": {
            "field": "value"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#657267"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "ticks"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "rightZero + datum.value * barScale"
          },
          "y": {
            "value": 600
          },
          "text": {
            "field": "value"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#657267"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "leftZero - 20 * barScale"
          },
          "y": {
            "value": 28
          },
          "text": {
            "value": "Threatened species"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 17
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#b66d61"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "chartCenter"
          },
          "y": {
            "value": 28
          },
          "text": {
            "value": "Bird family"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 15
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#28352d"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "rightZero + 20 * barScale"
          },
          "y": {
            "value": 28
          },
          "text": {
            "value": "Other species"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 17
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#7d997e"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "families"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "leftZero - datum.threatened_species * barScale"
          },
          "x2": {
            "signal": "leftZero"
          },
          "y": {
            "signal": "92 + (datum.rank - 1) * 40"
          },
          "height": {
            "value": 25
          },
          "fill": {
            "value": "#b66d61"
          },
          "cornerRadius": {
            "value": 2
          },
          "tooltip": {
            "signal": "datum.family_label + ': ' + datum.threatened_species + ' threatened, ' + datum.not_threatened_species + ' other species (' + format(datum.threatened_pct, '.1f') + '% threatened)'"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "families"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "rightZero"
          },
          "x2": {
            "signal": "rightZero + datum.not_threatened_species * barScale"
          },
          "y": {
            "signal": "92 + (datum.rank - 1) * 40"
          },
          "height": {
            "value": 25
          },
          "fill": {
            "value": "#7d997e"
          },
          "cornerRadius": {
            "value": 2
          },
          "tooltip": {
            "signal": "datum.family_label + ': ' + datum.threatened_species + ' threatened, ' + datum.not_threatened_species + ' other species (' + format(datum.threatened_pct, '.1f') + '% threatened)'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "families"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "chartCenter"
          },
          "y": {
            "signal": "105 + (datum.rank - 1) * 40"
          },
          "text": {
            "field": "family_label"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": 500
          },
          "fill": {
            "value": "#28352d"
          },
          "tooltip": {
            "signal": "datum.family_label + ': ' + datum.threatened_species + ' threatened, ' + datum.not_threatened_species + ' other species (' + format(datum.threatened_pct, '.1f') + '% threatened)'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "families"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "leftZero - datum.threatened_species * barScale - 6"
          },
          "y": {
            "signal": "105 + (datum.rank - 1) * 40"
          },
          "text": {
            "field": "threatened_species"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#b66d61"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "families"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "rightZero + datum.not_threatened_species * barScale + 7"
          },
          "y": {
            "signal": "105 + (datum.rank - 1) * 40"
          },
          "text": {
            "field": "not_threatened_species"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#4d6b52"
          }
        }
      }
    }
  ],
  "config": {
    "text": {
      "font": "DM Sans"
    }
  }
}
